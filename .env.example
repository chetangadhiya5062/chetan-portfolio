# Copy to .env.local and fill in. Never commit real values.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# GitHub (read-only token is enough: public_repo / read:user)
GITHUB_TOKEN=

# Admin (/admin)
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Cron (/api/sync/all) - Vercel sends it as "Authorization: Bearer <value>"
CRON_SECRET=

# Optional
RESUME_URL=
GEMINI_API_KEY=
NEXT_PUBLIC_SITE_URL=https://chetangadhiya.vercel.app
